# Copy to .env and fill in what you need. Everything is optional: the defaults run fully offline.
ANTHROPIC_API_KEY=
HPRAG_LLM_PROVIDER=extractive        # or: anthropic
HPRAG_LLM_MODEL=claude-opus-5-5
HPRAG_VERIFIER_KIND=lexical          # or: nli | llm | ensemble
HPRAG_GUARD_MIN_FAITHFULNESS=0.6
HPRAG_LOG_LEVEL=INFO
HPRAG_LOG_FORMAT=pretty              # or: json
